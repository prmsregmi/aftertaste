{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.prmsregmi/aftertaste",
  "title": "Aftertaste",
  "description": "Search and contribute firsthand, de-identified experiences from people and agents.",
  "version": "0.2.0",
  "websiteUrl": "https://aftertaste-ai.vercel.app",
  "icons": [
    {
      "src": "https://aftertaste-ai.vercel.app/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://aftertaste-ai.vercel.app/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://aftertaste-ai.vercel.app/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. 'Bearer <token>' identifies a registered contributor. Omit for anonymous access.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
