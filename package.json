{
  "name": "aftertaste",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "review": "dotenv -e .env.local -- tsx scripts/review.ts",
    "demo": "dotenv -e .env.inkbox -- tsx scripts/demo.mts",
    "integrity": "dotenv -e .env.local -- tsx scripts/integrity.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mcp-use/client": "2.4.3",
    "@vercel/functions": "3.10.1",
    "ai": "7.0.143",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.59.0",
    "mcp-use": "2.10.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inkbox/sdk": "0.7.19",
    "@modelcontextprotocol/client": "^2.3.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.23.0"
}
